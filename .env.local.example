# Ticketmaster Discovery API
# Get your API key at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Amadeus API (Flight Search)
# Register at: https://developers.amadeus.com/
# Get Client ID and Secret from your Amadeus dashboard
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Google Maps API
# Get your API key at: https://cloud.google.com/maps-platform
# Enable: Maps JavaScript API, Geocoding API, Directions API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Booking.com Affiliate API (Optional - fallback to city tier estimates if not set)
# Get your API key at: https://www.booking.com/affiliate/
BOOKING_API_KEY=your_booking_api_key_here

# Database URL (SQLite for local development)
# For SQLite: file:./prisma/dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/concert_deals
DATABASE_URL=file:./prisma/dev.db
